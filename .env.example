# Copier en .env pour le poste. En production, ces valeurs vivent dans les variables
# d'environnement de l'application Coolify, jamais dans le dépôt (il est public).

# Vide en local ; `production` ou `staging` une fois déployé. Renseignée, elle impose
# ADMIN_PASSWORD, SESSION_SECRET (32 caractères minimum) et une base PostgreSQL.
MOVIEPLOT_ENV=

# SQLite par défaut en local ; PostgreSQL ailleurs (voir compose.yaml pour le socle local).
# DATABASE_URL=postgresql+psycopg://movieplot:movieplot@localhost:5433/movieplot

# Connexion à l'espace /admin.
ADMIN_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

TMDB_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
ANTHROPIC_API_KEY=
# MOVIEPLOT_CLAUDE_MODEL=claude-opus-5-5
